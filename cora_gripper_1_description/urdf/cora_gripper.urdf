<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="cora_gripper">

    <!-- Gripper -->
    <link name="gripper_body">
        <visual>
        <origin xyz="0 -1.17217 -0.059" rpy="-1.5708 -1.570793 0" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_body_visual.dae" />
        </geometry>
        </visual>
        <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_body_visual.dae" />
        </geometry>
        </collision>
        <inertial>
        <mass value="0.044" />
        <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.000062" iyz="0.000001" izz="0.000075" />
        </inertial>
    </link>

    <link name="Gripper">
    </link>

    <link name="Camera">
    </link>

    <link name="Camera_optical">
    </link>

    <link name="gripper_fingers">
        <visual>
        <origin xyz="1.17667 0.0095 0.07" rpy="-1.5708 0 1.5708" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_fingers_visual.dae" />
        </geometry>
        </visual>
        <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_fingers_visual.dae" />
        </geometry>
        </collision>
        <inertial>
        <mass value="0.05" />
        <inertia ixx="0.000025" ixy="0.000002" ixz="0.000002" iyy="0.000016" iyz="-0.000001" izz="0.000018" />
        </inertial>
    </link>
    <link name="gripper_fingers_2">
        <visual>
        <origin xyz="-1.16767 0.0095 0.07" rpy="1.5708 0 1.5708" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_fingers_2_visual.dae" />
        </geometry>
        </visual>
        <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="file://$(find cora_gripper_1_description)/meshes/gripper_fingers_2_visual.dae" />
        </geometry>
        </collision>
        <inertial>
        <mass value="0.05" />
        <inertia ixx="0.000025" ixy="0.000002" ixz="0.000002" iyy="0.000016" iyz="-0.000001" izz="0.000018" />
        </inertial>
    </link>

    <joint name="GripperFix" type="fixed">
        <origin xyz="0 0 -0.024" rpy="0 0 1.5708" />
        <parent link="endeffector" />
        <child link="gripper_body" />
    </joint>

    <joint name="Gripper_frame" type="fixed">
        <origin xyz="0 0 -0.112" rpy="-3.14159 0 0" />
        <parent link="gripper_body" />
        <child link="Gripper" />
    </joint>

    <joint name="Camera_frame" type="fixed">
        <origin xyz="0.016614 0.0515 -0.046096" rpy="-1.57 1.57 0.0" />
        <parent link="gripper_body" />
        <child link="Camera" />
    </joint>

    <joint name="Camera_frame_optical" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 -1.5708" />
        <parent link="Camera" />
        <child link="Camera_optical" />
    </joint>
    
    <joint name="Finger1" type="prismatic">
        <origin xyz="0.07 0.0045 -0.0685" rpy="1.5708 0 -1.5708" />
        <parent link="gripper_body" />
        <child link="gripper_fingers" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="0" upper="0.0385" />
    </joint>
    <joint name="Finger2" type="prismatic">
        <origin xyz="-0.07 -0.0045 -0.0685" rpy="1.5708 0 1.5708" />
        <parent link="gripper_body" />
        <child link="gripper_fingers_2" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="0" upper="0.0385" />
        <mimic joint="Finger1" />
    </joint>

    <!-- Sensors -->
    <gazebo reference="Camera">
        <sensor name="gz_gripper_cam" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <!-- <pose>0.016614 -0.0515 -0.046096 0.000003 -3.141593 -0.000003</pose> -->
            <camera name="logitech c920">
                <horizontal_fov>0.959931</horizontal_fov>
                <image>
                <width>1280</width>
                <height>720</height>
                <format>R8G8B8</format>
                </image>
                <clip>
                <near>0.0001</near>
                <far>1000</far>
                </clip>
                <noise>
                <type>gaussian</type>
                </noise>
            </camera>
            <gz_frame_id>Camera_optical</gz_frame_id>
        </sensor>
    </gazebo>
    
    </xacro:macro>
</robot>