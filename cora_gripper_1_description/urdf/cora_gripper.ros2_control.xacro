<?xml version="1.0"?>
<!-- TODO: #3 Collapse these two copy-pasted <joint> blocks into ONE recursive
     xacro macro driven by the generated robot_layout.yaml. The node_id values
     (6) are hardcoded here but are only known to the configurator.
     This file already loads YAML for initial_positions — extend that to the
     joint list itself. Verified working on Jazzy; pattern and gotchas
     (&lt; escaping, no set() in the sandbox) are in C-O-R-A/cora_common#3. -->
<!-- TODO: #3 Finger2 is a state-only mimic joint (no command_interface).
     robot_layout.yaml needs a mimic_joints map to express this. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="cora_gripper_ros2_control" params="name initial_positions_file hardware_type">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">

            <hardware>
              <!-- By default, set up controllers for fake system-->
              <xacro:if value="${hardware_type == 'Fake'}">
                <plugin>mock_components/GenericSystem</plugin> <!-- Mock Components -->
              </xacro:if>

              <!-- Real Hardware Components -->
              <xacro:if value="${hardware_type == 'Real'}">
                <plugin>gripper_1_ros2_control_plugin/GripperHardwareInterface</plugin>
                <param name="can">can0</param>
              </xacro:if>

              <!-- Gazebo hardware components -->
              <xacro:if value="${hardware_type == 'Gazebo'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
              </xacro:if>
            </hardware>

            <joint name="Finger1">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Finger1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">6</param>
            </joint>

            <joint name="Finger2">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="node_id">6</param>
            </joint>
        </ros2_control>
    </xacro:macro>
</robot>
