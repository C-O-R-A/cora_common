<?xml version="1.0"?>
<!-- TODO: #3 Collapse these six copy-pasted <joint> blocks into ONE recursive
     xacro macro driven by the generated robot_layout.yaml. The node_id values
     (0-5) are hardcoded here but are only known to the configurator.
     This file already loads YAML for initial_positions — extend that to the
     joint list itself. Verified working on Jazzy; pattern and gotchas
     (&lt; escaping, no set() in the sandbox) are in C-O-R-A/cora_common#3. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="cora_ros2_control" params="name initial_positions_file hardware_type">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">

            <hardware>
              <!-- By default, set up controllers for fake system-->
              <xacro:if value="${hardware_type == 'Fake'}">
                <plugin>mock_components/GenericSystem</plugin> <!-- Mock Components -->
              </xacro:if>

              <!-- Real Hardware Components -->
              <xacro:if value="${hardware_type == 'Real'}">
                <plugin>odrive_ros2_control_plugin/odriveHardwareInterface</plugin>
                <param name="can">can0</param>
                <param name="initial_positions_file">${initial_positions_file}</param>
              </xacro:if>

              <!-- Gazebo hardware components -->
              <xacro:if value="${hardware_type == 'Gazebo'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                <param name="update_rate">1000</param>
              </xacro:if>
            </hardware>

            <joint name="J1">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">0</param>
                <param name="pos_gain">60.0</param>
                <param name="vel_gain">0.1</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

            <joint name="J2">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">1</param>
                <param name="pos_gain">60.0</param>
                <param name="vel_gain">0.1</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

            <joint name="J3">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">2</param>
                <param name="pos_gain">60.0</param>
                <param name="vel_gain">0.1</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

            <joint name="J4">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">3</param>
                <param name="pos_gain">120.0</param>
                <param name="vel_gain">0.012</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

            <joint name="J5">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">4</param>
                <param name="node_id">3</param>
                <param name="pos_gain">120.0</param>
                <param name="vel_gain">0.012</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

            <joint name="J6">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['J6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <param name="node_id">5</param>
                <param name="node_id">3</param>
                <param name="pos_gain">120.0</param>
                <param name="vel_gain">0.012</param>
                <param name="vel_integrator_gain">0</param>  
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
