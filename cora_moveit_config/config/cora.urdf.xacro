<?xml version="1.0"?>
<!-- TODO: #3 GENERATED ARTIFACT — the configurator must emit this top-level file,
     not just the bare kinematic chain it produces today. Missing from its output:
     the hardware_type/gripper_package/initial_positions_file args, the ros2_control
     include, and the Gazebo branch. See C-O-R-A/configurator#4.
     NOTE: this file must stay GENERATED TEXT, not a generic file that loops
     robot_layout.yaml — xacro:include with a computed filename inside a macro does
     not register the included macros, and the joint-library macros take *origin as
     a block param that cannot be built from YAML. Verified on Jazzy; see
     C-O-R-A/configurator#1. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cora">

    <!-- ================= -->
    <!-- Declare arguments -->
    <!-- ================= -->
    <xacro:arg name="hardware_type" default="Fake"/>
    <xacro:arg name="gripper_package" default="None"/>
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>

    <!-- ================= -->
    <!-- Base robot        -->
    <!-- ================= -->
    <xacro:include filename="$(find cora_description)/urdf/cora.urdf"/>

    <!-- ================= -->
    <!-- ros2_control      -->
    <!-- ================= -->

    <!-- Store hardware_type -->
    <xacro:property
        name="hardware_type"
        value="$(arg hardware_type)"/>

    <xacro:if value="${hardware_type != 'Gazebo'}">
        <xacro:include filename="cora.ros2_control.xacro"/>
        <xacro:cora_ros2_control
            name="CoraSystem"
            hardware_type="$(arg hardware_type)"
            initial_positions_file="$(arg initial_positions_file)"/>
    </xacro:if>

    <xacro:if value="${hardware_type == 'Gazebo'}">

        <!-- gazebo ros2 control configuration -->
        <xacro:include filename="cora_gazebo.ros2_control.xacro"/>
        <xacro:cora_gazebo_ros2_control
            initial_positions_file="$(arg initial_positions_file)"/>
        
        <!-- gazebo sensors and plugins -->
        <xacro:include filename="$(find cora_gazebo)/config/cora_gazebo.xacro"/>
        <xacro:cora_gazebo/>
    </xacro:if>

    <!-- ================= -->
    <!-- Optional gripper  -->
    <!-- ================= -->

    <!-- Store gripper package -->
    <xacro:property
        name="gripper_package_name"
        value="$(arg gripper_package)"/>

    <!-- Store gripper package path -->
    <xacro:property
        name="gripper_package_path"
        value="$(find ${gripper_package_name})"/>

    <!-- Only load gripper if one is provided -->
    <xacro:if value="${gripper_package_name != 'None'}">

        <!-- Load gripper macros -->
        <xacro:include filename="${gripper_package_path}/urdf/cora_gripper.urdf.xacro"/>

        <!-- Instantiate gripper -->
        <xacro:cora_gripper_xacro
            hardware_type="$(arg hardware_type)"
            initial_positions_file="$(arg initial_positions_file)"/>

    </xacro:if>
</robot>
